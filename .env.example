# Copy to .env and fill locally. Do not commit real keys.
FINMIND_TOKEN=
FUGLE_API_KEY=

# MCP server
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=9123
MCP_SSE_PATH=/sse
MCP_MESSAGE_PATH=/messages/
MCP_STREAMABLE_HTTP_PATH=/mcp

# Optional morning briefing delivery targets.
# Format used by scripts/tw_morning_briefing.py: channel:target
# Examples only; set real targets locally.
TW_MORNING_DELIVERIES=discord:user:YOUR_DISCORD_USER_ID,line:YOUR_LINE_USER_ID
TW_MORNING_ANNOUNCEMENT_LIMIT=8
TW_MORNING_TIMEOUT_SECONDS=180

# Optional per-friend copies: each friend should keep their own private .env
# and replace the targets with their own Discord / LINE destination.
# Example:
# TW_MORNING_DELIVERIES=discord:user:FRIEND_DISCORD_ID,line:FRIEND_LINE_USER_ID
